[Unit]
Description=Double – Multiplayer-Symbolsuchspiel
After=network.target

[Service]
Type=simple

# ---- Ggf. anpassen -------------------------------------------------------
# ExecStart braucht den vollen Pfad zum deno-Binary (`which deno`).
# Wichtig: das Binary muss für www-data lesbar sein – liegt es unter
# /root/.deno/bin/, nach /usr/local/bin/deno kopieren.
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/double
ExecStart=/usr/local/bin/deno run --allow-net --allow-read --allow-env --allow-sys server.js
Environment=PORT=8077
# --------------------------------------------------------------------------

# www-data darf nicht in sein Home schreiben; Deno legt seinen Cache sonst
# dort an und startet nicht. PrivateTmp macht das /tmp prozess-eigen.
Environment=DENO_DIR=/tmp/deno-cache

Restart=always
RestartSec=3

# Das Spiel hält seinen Zustand nur im RAM und schreibt nichts auf Platte.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
